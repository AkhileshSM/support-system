# ═══════════════════════════════════════════════════════════════
#  Customer Support System — Environment Variables
#  Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── LLM Provider: Local Ollama ───────────────────────────────
# Points to your host machine's Ollama instance from inside Docker.
# Default: http://host.docker.internal:11434 (works on Mac/Windows Docker Desktop)
# If running Ollama on a different host/port, change this.
OLLAMA_API_BASE=http://host.docker.internal:11434

# ── AgentField Server (don't change for local Docker) ────────
AGENTFIELD_SERVER=http://agentfield-server:8080
# OR use OpenAI
# OPENAI_API_KEY=sk-your-key-here
