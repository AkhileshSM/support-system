# ═══════════════════════════════════════════════════════════════
#  Customer Support System — Environment Variables
#  Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── LLM Provider: Local Ollama ───────────────────────────────
# Points to your host machine's Ollama instance from inside Docker.
# Default: http://host.docker.internal:11434 (works on Mac/Windows Docker Desktop)
# If running Ollama on a different host/port, change this.
OLLAMA_API_BASE=http://host.docker.internal:11434

# ── Decision gate: Ollama POST /v1/systemone ─────────────────
# Requires Ollama >= 0.35 and `ollama pull tev1:0.8b` (make pull-gate-model).
# Inside Docker this must be host.docker.internal, not localhost.
# Swap SYSTEMONE_MODEL to compare another local systemone model (for example nimble).
SYSTEMONE_BASE=http://host.docker.internal:11434
SYSTEMONE_MODEL=tev1:0.8b
# Skip sentiment + routing only when the gate's confidence is at least this.
GATE_CONFIDENCE_MIN=0.7
# Fail the gate quickly so a cold or missing model falls back to the full path.
SYSTEMONE_TIMEOUT_S=3

# ── AgentField Server (don't change for local Docker) ────────
AGENTFIELD_SERVER=http://agentfield-server:8080
